<%- include('partials/header') %>

<section class="checkout-shell" style="background:#f4f6f7;">
  <div class="container py-5">
    <header class="mb-4">
      <p class="text-muted small mb-1">Secure checkout</p>
      <h1 class="mb-1 fw-semibold">Finish your order</h1>
      <p class="text-muted mb-0">One last step—confirm delivery and payment to complete your purchase.</p>
    </header>

    <div class="row g-4">
      <!-- LEFT -->
      <div class="col-lg-7">
        <form method="POST" action="/checkout" id="checkout-form" class="card border-0 shadow-sm p-4" novalidate>
          <input type="hidden" name="deliveryMethod" id="deliveryMethod" value="standard">
          <input type="hidden" name="deliveryFee" id="deliveryFee" value="3.50">

          <input type="hidden" name="paypalOrderId" id="paypalOrderId" value="">
          <input type="hidden" name="paypalCaptureId" id="paypalCaptureId" value="">
          <input type="hidden" name="paypalPaid" id="paypalPaid" value="0">

          <!-- Wallet -->
          <input type="hidden" name="walletPaid" id="walletPaid" value="0">

          <!-- Stripe -->
          <input type="hidden" name="stripePaymentIntentId" id="stripePaymentIntentId" value="">
          <input type="hidden" name="stripePaid" id="stripePaid" value="0">

          <!-- OTP required flag -->
          <input type="hidden" name="otpRequired" id="otpRequired" value="0">

          <section class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h4 class="mb-0 fw-semibold">Delivery</h4>
              <span class="badge bg-success-subtle text-success">Step 1 of 2</span>
            </div>
            <p class="text-muted small mb-3">Choose the option that works best for your schedule.</p>

            <div class="row g-3">
              <div class="col-12">
                <label class="checkout-option d-flex align-items-center">
                  <input type="radio" name="delivery" value="standard" data-fee="3.50" checked>
                  <div class="checkout-option-body">
                    <strong>Standard Delivery</strong>
                    <span class="text-muted small">2-3 days</span>
                  </div>
                  <span class="price-tag">$3.50</span>
                </label>
              </div>
              <div class="col-12">
                <label class="checkout-option d-flex align-items-center">
                  <input type="radio" name="delivery" value="express" data-fee="6.00">
                  <div class="checkout-option-body">
                    <strong>Express Delivery</strong>
                    <span class="text-muted small">Same day</span>
                  </div>
                  <span class="price-tag">$6.00</span>
                </label>
              </div>
              <div class="col-12">
                <label class="checkout-option d-flex align-items-center">
                  <input type="radio" name="delivery" value="pickup" data-fee="0">
                  <div class="checkout-option-body">
                    <strong>Store Pickup</strong>
                    <span class="text-muted small">Collect today • Free</span>
                  </div>
                  <span class="price-tag">$0.00</span>
                </label>
              </div>
            </div>

            <div class="aml-note mt-3">
              <div class="shield">✓</div>
              <div>
                <strong class="d-block">Secure & AML checks</strong>
                <small class="text-muted">We perform AML and identity verification for high-value orders. Payments are encrypted and PCI-DSS compliant.</small>
              </div>
            </div>

            <div class="row g-3 mt-2" id="delivery-fields">
              <div class="col-12">
                <label class="form-label small text-muted">Recipient name</label>
                <input type="text" class="form-control" name="shippingName" placeholder="Full name for delivery"
                  value="<%= user ? user.username : '' %>" required>
              </div>

              <div class="col-12">
                <label class="form-label small text-muted">Contact number</label>
                <input type="tel" class="form-control" name="shippingPhone" id="shippingPhone"
                  placeholder="+65 81234567" pattern="^(\+65\s?)?\d{8}$" required>
                <div class="invalid-feedback">Enter an 8-digit Singapore number (optionally prefixed with +65).</div>
              </div>

              <div class="col-12">
                <label class="form-label small text-muted">Delivery address</label>
                <textarea class="form-control" name="shippingAddress" rows="3" placeholder="Block / Unit / Postal code" required></textarea>
                <div class="invalid-feedback" id="addr-feedback">Please put unit number and full address</div>
              </div>
            </div>
          </section>

          <section class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h4 class="mb-0 fw-semibold">Payment method</h4>
              <span class="badge bg-success-subtle text-success">Step 2 of 2</span>
            </div>
            <p class="text-muted small mb-3">Pick how you’d like to pay.</p>

            <!-- ✅ FIXED nesting: no stray closing tags -->
            <div class="row g-3">
              <div class="col-12">

                <label class="d-flex align-items-center mb-2">
                  <input type="radio" name="payment" value="stripe" checked>
                  <div class="ms-2">Stripe (card / GrabPay / Alipay)</div>
                </label>

                <label class="d-flex align-items-center mb-2">
                  <input type="radio" name="payment" value="wallet">
                  <div class="ms-2">
                    FreshMart Wallet
                    <div class="text-muted small">S$ <%= Number(walletBalance || 0).toFixed(2) %> • <a href="/wallet" target="_blank">Top up</a></div>
                  </div>
                </label>

                <label class="d-flex align-items-center mb-2">
                  <input type="radio" name="payment" value="paypal">
                  <div class="ms-2">PayPal</div>
                </label>

                <label class="d-flex align-items-center mb-2">
                  <input type="radio" name="payment" value="paynow">
                  <div class="ms-2">PayNow (QR)</div>
                </label>

                <label class="d-flex align-items-center mb-2">
                  <input type="radio" name="payment" value="bank">
                  <div class="ms-2">Bank Transfer</div>
                </label>

                <label class="d-flex align-items-center mb-2">
                  <input type="radio" name="payment" value="cod">
                  <div class="ms-2">Cash on Delivery</div>
                </label>

                <!-- ✅ NETS as radio -->
                <label class="d-flex align-items-center mb-2">
                  <input type="radio" name="payment" value="nets">
                  <div class="ms-2">NETS (QR)</div>
                </label>

                <div class="text-muted small mt-1" id="nets-hint" style="display:none;">
                  NETS will bring you to a QR page after you click "Complete Order".
                </div>

                <!-- PayPal UI -->
                <div id="paypal-wrap" style="display:none; margin-top:10px;">
                  <div id="paypal-error" style="display:none;color:#b00020;margin-bottom:8px"></div>
                  <div id="paypal-button-container"></div>
                </div>

                <!-- Stripe Elements UI -->
                <div id="stripe-card-wrap" class="p-3 bg-light rounded border" style="display:none; margin-top:10px;">
                  <div class="fw-semibold mb-2">Pay by card, GrabPay, Alipay, etc.</div>
                  <div id="stripe-payment-element"></div>
                  <div id="stripe-card-errors" class="text-danger small mt-2" role="alert"></div>
                  <div class="text-muted small mt-2">Stripe shows every payment method you enabled for this currency (card, GrabPay, Alipay, …).</div>
                </div>

              </div>
            </div>

            <div class="mt-3">
              <button type="submit" id="complete-order-btn" class="btn btn-primary btn-lg w-100">Complete Order</button>
            </div>
          </section>
        </form>
      </div>

      <!-- RIGHT -->
      <aside class="col-lg-5">
        <div class="card border-0 shadow-sm p-4 mb-3">
          <h6 class="fw-semibold mb-3">Order summary</h6>
          <div class="table-responsive">
            <table class="table table-borderless small mb-0">
              <tbody>
                <% if (items && items.length) { %>
                  <% items.forEach(function(it){ %>
                    <% var _name = it.name || it.title || 'Item';
                       var _qty = Number(it.qty || it.quantity || 1) || 1;
                       var _price = Number(it.price || 0);
                       var _line = (typeof it.subtotal === 'number') ? Number(it.subtotal) : (_price * _qty); %>
                    <tr>
                      <td><%= _name %> x <%= _qty %></td>
                      <td class="text-end">S$ <%= (_line && !isNaN(_line) ? _line : 0).toFixed(2) %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="2">Your cart is empty</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <div class="summary-row mt-3">
            <span>Subtotal</span>
            <strong id="summary-subtotal">S$ <%= Number(total || 0).toFixed(2) %></strong>
          </div>

          <div class="summary-row">
            <span>Delivery</span>
            <strong id="summary-delivery">S$ 3.50*</strong>
          </div>

          <div class="summary-row total-row mt-2">
            <span>Amount due</span>
            <strong id="summary-total">S$ <%= (Number(total || 0) + 3.5).toFixed(2) %></strong>
          </div>

          <div class="mt-3 p-3 bg-light rounded" id="wallet-info" style="display:<%= (walletBalance||0)>0 ? 'block' : 'none' %>;">
            <div class="d-flex justify-content-between align-items-center">
              <span class="text-muted">Wallet balance</span>
              <strong>S$ <%= Number(walletBalance || 0).toFixed(2) %></strong>
            </div>
            <small class="text-muted">Session-based demo balance.</small>
          </div>
        </div>
      </aside>

    </div>
  </div>
</section>

<%- include('partials/footer') %>

<!-- PayPal SDK -->
<script src="https://www.paypal.com/sdk/js?client-id=<%= paypalClientId %>&currency=<%= paypalCurrency %>"></script>
<!-- Stripe JS -->
<script src="https://js.stripe.com/v3/"></script>

<script>
  (function(){
    const deliveryRadios = document.querySelectorAll('input[name="delivery"]');
    const deliveryFeeInput = document.getElementById('deliveryFee');
    const summaryDelivery = document.getElementById('summary-delivery');
    const summaryTotal = document.getElementById('summary-total');
    const subtotal = <%= Number(total || 0).toFixed(2) %>;

    const paymentRadios = document.querySelectorAll('input[name="payment"]');
    const paypalWrap = document.getElementById('paypal-wrap');
    const paypalError = document.getElementById('paypal-error');

    const paypalOrderIdEl = document.getElementById('paypalOrderId');
    const paypalPaidEl = document.getElementById('paypalPaid');
    const paypalCaptureIdEl = document.getElementById('paypalCaptureId');
    const otpRequiredEl = document.getElementById('otpRequired');
    const stripeIntentIdEl = document.getElementById('stripePaymentIntentId');
    const stripePaidEl = document.getElementById('stripePaid');
    const stripeCardWrap = document.getElementById('stripe-card-wrap');
    const stripeCardErrors = document.getElementById('stripe-card-errors');
    const stripePublishableKey = "<%= stripePublishableKey || '' %>" || null;
    const stripeCurrency = ("<%= stripeCurrency || 'SGD' %>" || 'SGD').toLowerCase();

    const checkoutForm = document.getElementById('checkout-form');
    const completeBtn = document.getElementById('complete-order-btn');
    const netsHint = document.getElementById('nets-hint');

    const __clientCartItems = <%- JSON.stringify(items || []) %>;
    const __clientCartSubtotal = <%= Number(total || 0).toFixed(2) %>;

    function formatMoney(v){ return 'S$ ' + Number(v).toFixed(2); }

    function updateDelivery(){
      const sel = Array.from(deliveryRadios).find(r => r.checked);
      const fee = sel ? Number(sel.dataset.fee || 0) : 0;

      deliveryFeeInput.value = fee.toFixed(2);
      summaryDelivery.textContent = formatMoney(fee) + '*';
      summaryTotal.textContent = formatMoney(Number(subtotal) + fee);

      const deliveryMethodInput = document.getElementById('deliveryMethod');
      if (deliveryMethodInput && sel) deliveryMethodInput.value = sel.value;

      const deliveryFieldsDiv = document.getElementById('delivery-fields');
      if (deliveryFieldsDiv) {
        if (sel && sel.value === 'pickup') {
          deliveryFieldsDiv.style.display = 'none';
          Array.from(deliveryFieldsDiv.querySelectorAll('input, textarea')).forEach(el=>{
            el.dataset._wasRequired = el.required ? '1' : '0';
            el.required = false;
          });
        } else {
          deliveryFieldsDiv.style.display = '';
          Array.from(deliveryFieldsDiv.querySelectorAll('input, textarea')).forEach(el=>{
            if (el.dataset._wasRequired === '1' || ['shippingName','shippingPhone','shippingAddress'].includes(el.name)) {
              el.required = true;
            }
          });
        }
      }
    }

    deliveryRadios.forEach(r => r.addEventListener('change', updateDelivery));
    updateDelivery();
    // If user is on Stripe, refresh Payment Element when delivery fee changes so total stays in sync
    deliveryRadios.forEach(r => r.addEventListener('change', () => {
      const selPay = Array.from(paymentRadios).find(x => x.checked);
      if (selPay && selPay.value === 'stripe') {
        stripeClientSecret = null;
        stripePaymentElement = null;
        stripeElements = null;
        if (stripePaymentContainer) stripePaymentContainer.innerHTML = '';
        initStripeElement().catch(err => {
          console.error(err);
          if (stripeCardErrors) stripeCardErrors.textContent = err.message || 'Stripe not available.';
        });
      }
    }));

    function setPaypalError(msg){
      if (!paypalError) return;
      paypalError.textContent = msg;
      paypalError.style.display = 'block';
    }

    function clearPaypalError(){
      if (!paypalError) return;
      paypalError.textContent = '';
      paypalError.style.display = 'none';
    }

    let paypalRendered = false;
    let isSubmitting = false;
    let creatingOrder = false;
    let stripe = null;
    let stripeElements = null;
    let stripePaymentElement = null;
    let stripeProcessing = false;
    const stripePaymentContainer = document.getElementById('stripe-payment-element');
    let stripeClientSecret = null;
    let stripeReturnHandled = false;

    function ensureStripeElement(){
      if (!stripePublishableKey) {
        console.warn('Stripe publishable key missing.');
        return false;
      }
      if (typeof Stripe === 'undefined') {
        console.error('Stripe.js failed to load.');
        if (stripeCardErrors) stripeCardErrors.textContent = 'Stripe failed to load. Please choose another method.';
        return false;
      }
      if (!stripe) stripe = Stripe(stripePublishableKey);
      // elements will be created after we fetch a clientSecret
      if (stripeCardWrap) stripeCardWrap.style.display = 'block';
      return true;
    }

    function setButtonLoading(isLoading) {
      if (!completeBtn) return;
      completeBtn.disabled = isLoading;
      completeBtn.textContent = isLoading ? 'Processing…' : 'Complete Order';
    }

    // Persist and restore shipping/delivery so redirect flows keep data
    function saveCheckoutDraft(){
      try {
        const data = {
          delivery: Array.from(deliveryRadios).find(r=>r.checked)?.value || 'standard',
          shippingName: document.querySelector('input[name=\"shippingName\"]')?.value || '',
          shippingPhone: document.getElementById('shippingPhone')?.value || '',
          shippingAddress: document.querySelector('textarea[name=\"shippingAddress\"]')?.value || '',
        };
        sessionStorage.setItem('checkoutDraft', JSON.stringify(data));
      } catch(e){ /* ignore */ }
    }
    function restoreCheckoutDraft(){
      try {
        const raw = sessionStorage.getItem('checkoutDraft');
        if (!raw) return;
        const data = JSON.parse(raw);
        if (data.delivery) {
          const r = Array.from(deliveryRadios).find(x=>x.value===data.delivery);
          if (r) { r.checked = true; updateDelivery(); }
        }
        if (data.shippingName) {
          const el = document.querySelector('input[name=\"shippingName\"]');
          if (el) el.value = data.shippingName;
        }
        if (data.shippingPhone) {
          const el = document.getElementById('shippingPhone');
          if (el) el.value = data.shippingPhone;
        }
        if (data.shippingAddress) {
          const el = document.querySelector('textarea[name=\"shippingAddress\"]');
          if (el) el.value = data.shippingAddress;
        }
      } catch(e){ /* ignore */ }
    }

    async function initStripeElement(){
      if (!ensureStripeElement()) throw new Error('Stripe not available.');

      const selDelivery = Array.from(deliveryRadios).find(r => r.checked);
      const fee = selDelivery ? Number(selDelivery.dataset.fee || 0) : 0;
      const shippingName = document.querySelector('input[name="shippingName"]')?.value || '';
      const shippingPhone = document.getElementById('shippingPhone')?.value || '';

      const resp = await fetch('/stripe/create-payment-intent', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({
          deliveryFee: fee.toFixed(2),
          items: __clientCartItems,
          subtotal: __clientCartSubtotal,
          shippingName
        })
      });

      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.clientSecret) {
        throw new Error(data?.error || 'Unable to start Stripe payment.');
      }

      stripeClientSecret = data.clientSecret;
      if (stripeIntentIdEl) stripeIntentIdEl.value = data.intentId || '';

      stripeElements = stripe.elements({ clientSecret: data.clientSecret });
      if (stripePaymentContainer) stripePaymentContainer.innerHTML = '';
      stripePaymentElement = stripeElements.create('payment', {
        layout: {
          type: 'accordion', // avoids horizontal overflow/dropdown on smaller widths
          defaultCollapsed: false
        },
        defaultValues: {
          billingDetails: {
            name: shippingName || undefined,
            phone: shippingPhone || undefined,
          }
        }
      });
      stripePaymentElement.mount('#stripe-payment-element');
    }

    function maybeRenderPaypal(){
      if (paypalRendered) return;

      if (typeof paypal === 'undefined' || !paypal?.Buttons) {
        setPaypalError('PayPal SDK failed to load.');
        return;
      }

      paypalRendered = true;

      const c = document.getElementById('paypal-button-container');
      if (c) c.innerHTML = '';

      paypal.Buttons({
        createOrder: function(){
          clearPaypalError();

          if (creatingOrder) {
            return Promise.reject(new Error("Order creation already in progress."));
          }
          creatingOrder = true;

          const fee = Number(deliveryFeeInput?.value || 0);
          const shipName = document.querySelector('input[name="shippingName"]')?.value || '';

          return fetch('/paypal/create-order', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify({
              deliveryFee: fee.toFixed(2),
              items: __clientCartItems,
              subtotal: __clientCartSubtotal,
              shippingName: shipName
            })
          })
          .then(async (r) => {
            const data = await r.json().catch(() => ({}));
            if (!r.ok) throw new Error(data?.error || `create-order failed (${r.status})`);
            return data;
          })
          .then(d => {
            if (!d?.id) throw new Error(d?.error || 'No order id');
            paypalOrderIdEl.value = d.id;
            return d.id;
          })
          .finally(() => {
            creatingOrder = false;
          });
        },

        onApprove: function(data){
          clearPaypalError();

          return fetch('/paypal/capture-order', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ orderId: data.orderID })
          })
          .then(async (r) => {
            const data = await r.json().catch(() => ({}));
            if (!r.ok) throw new Error(data?.error || `capture-order failed (${r.status})`);
            return data;
          })
          .then(async (res) => {
            if (res?.error) throw new Error(res.error);

            paypalPaidEl.value = '1';
            paypalCaptureIdEl.value =
              (res?.capture?.purchase_units?.[0]?.payments?.captures?.[0]?.id || '');

            otpRequiredEl.value = '1';

            await fetch('/send-otp', {
              method: 'POST',
              credentials: 'same-origin',
              headers: {'Content-Type':'application/json'},
              body: JSON.stringify({
                orderId: data.orderID,
                captureId: paypalCaptureIdEl.value,
                phone: document.getElementById('shippingPhone')?.value || ''
              })
            });

            if (!isSubmitting) {
              isSubmitting = true;
              checkoutForm.submit();
            }
          })
          .catch(err => {
            console.error(err);
            setPaypalError(err.message || 'PayPal capture error.');
            paypalPaidEl.value = '0';
            otpRequiredEl.value = '0';
            throw err;
          });
        },

        onError: function(err){
          console.error(err);
          setPaypalError(err?.message || 'PayPal error.');
          if (paypalPaidEl) paypalPaidEl.value = '0';
          if (otpRequiredEl) otpRequiredEl.value = '0';
        }
      }).render('#paypal-button-container')
        .catch(err => {
          console.error("PayPal render failed:", err);
          paypalRendered = false;
          setPaypalError('Failed to render PayPal buttons.');
        });
    }

    async function handleStripePayment(){
      stripePaidEl.value = '0';
      if (!stripePaymentElement || !stripeClientSecret) {
        await initStripeElement(); // build once so user choice (PayNow) is respected
      }
      saveCheckoutDraft();
      const confirmRes = await stripe.confirmPayment({
        elements: stripeElements,
        confirmParams: {
          return_url: window.location.origin + '/checkout', // stays on-page for this demo
        },
        redirect: 'if_required' // keep AJAX style when possible
      });

      if (confirmRes.error) {
        throw new Error(confirmRes.error.message || 'Card was declined.');
      }

      const pi = confirmRes.paymentIntent;
      if (!pi || (pi.status !== 'succeeded' && pi.status !== 'requires_capture')) {
        throw new Error('Payment not completed yet.');
      }

      stripePaidEl.value = '1';
      return pi;
    }

    async function handleStripeReturn(){
      if (stripeReturnHandled) return;
      const params = new URLSearchParams(window.location.search);
      const clientSecret = params.get('payment_intent_client_secret');
      const intentId = params.get('payment_intent');
      if (!clientSecret || !intentId || !stripePublishableKey) return;
      stripeReturnHandled = true;
      try {
        if (!stripe) stripe = Stripe(stripePublishableKey);
        const {paymentIntent} = await stripe.retrievePaymentIntent(clientSecret);
        if (paymentIntent && paymentIntent.status === 'succeeded') {
          restoreCheckoutDraft();
          const stripeRadio = Array.from(paymentRadios).find(r => r.value === 'stripe');
          if (stripeRadio) stripeRadio.checked = true;
          stripeIntentIdEl.value = paymentIntent.id;
          stripePaidEl.value = '1';
          otpRequiredEl.value = '0';
          // remove query params to avoid loops
          const url = new URL(window.location.href);
          url.searchParams.delete('payment_intent');
          url.searchParams.delete('payment_intent_client_secret');
          url.searchParams.delete('redirect_status');
          window.history.replaceState({}, document.title, url.toString());
          checkoutForm.submit();
        } else if (paymentIntent && paymentIntent.status === 'requires_payment_method') {
          if (stripeCardErrors) stripeCardErrors.textContent = 'Payment failed. Please try again with another method.';
        }
      } catch(err){
        console.error('Stripe return handling failed', err);
        if (stripeCardErrors) stripeCardErrors.textContent = err.message || 'Unable to verify Stripe payment.';
      }
    }

    // Payment change UI
    paymentRadios.forEach(r => r.addEventListener('change', () => {
      const sel = Array.from(paymentRadios).find(x => x.checked);
      const isPaypal = sel && sel.value === 'paypal';
      const isNets = sel && sel.value === 'nets';
      const isWallet = sel && sel.value === 'wallet';
      const isStripe = sel && sel.value === 'stripe';

      if (paypalWrap) paypalWrap.style.display = isPaypal ? 'block' : 'none';
      if (netsHint) netsHint.style.display = isNets ? 'block' : 'none';
      const walletInfo = document.getElementById('wallet-info');
      if (walletInfo) walletInfo.style.display = isWallet ? 'block' : 'none';
      if (stripeCardWrap) stripeCardWrap.style.display = isStripe ? 'block' : 'none';

      if (isPaypal) {
        paypalPaidEl.value = '0';
        otpRequiredEl.value = '0';
        maybeRenderPaypal();
      } else {
        otpRequiredEl.value = '0';
      }

      if (isStripe) {
        stripePaidEl.value = '0';
        // build the element now so user can pick PayNow/GrabPay before submit
        stripeClientSecret = null;
        stripePaymentElement = null;
        stripeElements = null;
        if (stripePaymentContainer) stripePaymentContainer.innerHTML = '';
        initStripeElement().catch(err => {
          console.error(err);
          if (stripeCardErrors) stripeCardErrors.textContent = err.message || 'Stripe not available.';
        });
      }
    }));

    // ✅ NETS redirect (Option A) + PayPal guard
    checkoutForm.addEventListener('submit', async function(e){
      const sel = Array.from(paymentRadios).find(x => x.checked);
      const isPaypal = sel && sel.value === 'paypal';
      const isNets = sel && sel.value === 'nets';
      const isWallet = sel && sel.value === 'wallet';
      const isStripe = sel && sel.value === 'stripe';

      if (isNets) {
        // Allow normal POST /checkout so server can create order/session then redirect
        if (!checkoutForm.checkValidity()) {
          e.preventDefault();
          e.stopPropagation();
          checkoutForm.reportValidity();
          return;
        }

        // optional: clear PayPal flags so server doesn't think PayPal flow
        paypalPaidEl.value = "0";
        otpRequiredEl.value = "0";
        return; // do NOT preventDefault
      }

      // For wallet, let the normal POST /checkout run; server debits wallet synchronously.

      if (isStripe) {
        if (!checkoutForm.checkValidity()) {
          e.preventDefault();
          e.stopPropagation();
          checkoutForm.reportValidity();
          return;
        }
        e.preventDefault();
        e.stopPropagation();
        if (stripeCardErrors) stripeCardErrors.textContent = '';
        if (stripeProcessing) return;
        stripeProcessing = true;
        setButtonLoading(true);
        try {
          await handleStripePayment();
          otpRequiredEl.value = '0';
          checkoutForm.submit();
        } catch(err) {
          console.error(err);
          if (stripeCardErrors) stripeCardErrors.textContent = err.message || 'Stripe payment failed.';
          stripePaidEl.value = '0';
          setButtonLoading(false);
          stripeProcessing = false;
        }
        return;
      }

      if (isPaypal && paypalPaidEl && paypalPaidEl.value !== '1') {
        e.preventDefault();
        e.stopPropagation();
        setPaypalError('Please complete PayPal payment first.');
        if (paypalWrap) paypalWrap.style.display = 'block';
        document.getElementById('paypal-button-container')?.scrollIntoView({behavior:'smooth', block:'center'});
      }
    });

    // Initial state
    (function initPaymentUI(){
      restoreCheckoutDraft();
      const sel = Array.from(paymentRadios).find(x => x.checked);
      const isPaypal = sel && sel.value === 'paypal';
      const isNets = sel && sel.value === 'nets';
      const isWallet = sel && sel.value === 'wallet';
      const isStripe = sel && sel.value === 'stripe';
      if (paypalWrap) paypalWrap.style.display = isPaypal ? 'block' : 'none';
      if (netsHint) netsHint.style.display = isNets ? 'block' : 'none';
      const walletInfo = document.getElementById('wallet-info');
      if (walletInfo) walletInfo.style.display = isWallet ? 'block' : 'none';
      if (stripeCardWrap) stripeCardWrap.style.display = isStripe ? 'block' : 'none';
      if (isStripe) ensureStripeElement();
      handleStripeReturn();
    })();

  })();
</script>
