<%- include('partials/header') %>

<section style="background:#f4f6f7; min-height: calc(100vh - 120px);">
  <div class="container py-5">
    <header class="mb-4">
      <p class="text-muted small mb-1">Secure checkout</p>
      <h1 class="mb-1 fw-semibold">Pay with NETS QR</h1>
      <p class="text-muted mb-0">Scan the QR code with your simulator app to complete payment.</p>
    </header>

    <div class="row g-4">
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm p-4">
          <div class="d-flex align-items-start justify-content-between mb-3">
            <div>
              <h5 class="mb-1 fw-semibold">Scan the QR code</h5>
              <div class="text-muted small">
                Keep this tab open. We will auto-detect payment status.
              </div>
            </div>
            <span class="badge bg-success-subtle text-success">NETS QR</span>
          </div>

          <div class="row g-4 align-items-center">
            <div class="col-md-7">
              <div class="border rounded-4 bg-white p-3 text-center">
                <img
                  src="<%= qrCodeUrl %>"
                  alt="NETS QR Code"
                  style="max-width: 320px; width: 100%; height: auto;"
                />
              </div>

              <div class="mt-3">
                <div class="d-flex justify-content-between small text-muted mb-1">
                  <span>Time remaining</span>
                  <strong id="timeRemaining" class="text-dark">
                    <%= (typeof timeRemaining !== 'undefined' && timeRemaining) ? timeRemaining : '5:00' %>
                  </strong>
                </div>
                <div class="progress" style="height: 10px;">
                  <div id="timeBar" class="progress-bar" role="progressbar" style="width: 100%"></div>
                </div>
                <div class="text-muted small mt-2">
                  This QR expires automatically. If it expires, just go back and generate a new one.
                </div>
              </div>

              <div class="mt-3 d-flex gap-2">
                <a href="/checkout" class="btn btn-outline-secondary">Back to checkout</a>
                <a href="/cart" class="btn btn-outline-dark">Back to cart</a>
              </div>
            </div>

            <div class="col-md-5">
              <div class="border rounded-4 bg-light p-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                  <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                  <strong id="statusTitle">Waiting for payment</strong>
                </div>
                <div class="text-muted small" id="statusMsg">
                  Scan the code and complete payment in the simulator app.
                </div>

                <hr class="my-3"/>

                <div class="small text-muted mb-1">Transaction reference</div>
                <div class="font-monospace small text-break"><%= txnRetrievalRef %></div>

                <% if (typeof amount !== 'undefined') { %>
                  <div class="small text-muted mt-3 mb-1">Amount</div>
                  <div class="fw-semibold">S$ <%= Number(amount).toFixed(2) %></div>
                <% } %>
              </div>

              <div class="alert alert-info mt-3 mb-0">
                <strong>Tip:</strong> If nothing happens after you pay, wait a few seconds. We check status every 5 seconds.
              </div>
            </div>
          </div>
        </div>
      </div>

      <aside class="col-lg-5">
        <div class="card border-0 shadow-sm p-4">
          <h6 class="fw-semibold mb-3">What happens next?</h6>
          <ol class="small text-muted mb-0">
            <li>Scan the NETS QR code in your simulator app.</li>
            <li>Approve the payment.</li>
            <li>This page will auto-update and redirect you on success.</li>
          </ol>
        </div>

        <div class="card border-0 shadow-sm p-4 mt-3">
          <h6 class="fw-semibold mb-2">Need to cancel?</h6>
          <p class="text-muted small mb-3">
            Cancelling will bring you back to checkout. Your cart stays unchanged.
          </p>
          <a href="/checkout" class="btn btn-danger w-100">Cancel payment</a>
        </div>
      </aside>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

<script>
  (function(){
    const txnRetrievalRef = "<%= txnRetrievalRef %>";

    // ===== Timer UI (5 minutes default) =====
    const totalSeconds = 5 * 60;
    let remainingSeconds = totalSeconds;

    const timeEl = document.getElementById('timeRemaining');
    const barEl = document.getElementById('timeBar');

    function formatTime(sec){
      const m = Math.floor(sec / 60);
      const s = sec % 60;
      return m + ":" + String(s).padStart(2, "0");
    }

    const timerId = setInterval(() => {
      remainingSeconds--;
      if (remainingSeconds < 0) remainingSeconds = 0;

      if (timeEl) timeEl.textContent = formatTime(remainingSeconds);

      const pct = Math.max(0, Math.floor((remainingSeconds / totalSeconds) * 100));
      if (barEl) barEl.style.width = pct + "%";

      if (remainingSeconds <= 0) clearInterval(timerId);
    }, 1000);

    // ===== Payment status via SSE =====
    const statusTitle = document.getElementById('statusTitle');
    const statusMsg = document.getElementById('statusMsg');

    function setStatus(title, msg){
      if (statusTitle) statusTitle.textContent = title;
      if (statusMsg) statusMsg.textContent = msg;
    }

    try {
      const evtSource = new EventSource(`/sse/payment-status/${txnRetrievalRef}`);

      evtSource.onmessage = function(event) {
        const data = JSON.parse(event.data || "{}");

        if (data.success) {
          setStatus("Payment successful", "Redirecting…");
          evtSource.close();
          window.location.href = "/nets-qr/success";
        }

        if (data.fail) {
          setStatus("Payment failed", data.message || "Please try again.");
          evtSource.close();
          window.location.href = "/nets-qr/fail";
        }
      };

      evtSource.onerror = function() {
        setStatus("Checking payment…", "Still waiting for an update.");
      };
    } catch (e) {
      console.error(e);
      setStatus("Waiting for payment", "Please keep this tab open.");
    }
  })();
</script>
