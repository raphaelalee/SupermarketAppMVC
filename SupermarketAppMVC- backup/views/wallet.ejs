<%- include('partials/header') %>

<section class="container py-5">
  <h1 class="mb-3">Wallet / PayPal</h1>
  <p class="text-muted">Quick access to your PayPal sandbox dashboard and recent PayPal transactions recorded by this site.</p>

  <div class="card p-3 mb-3">
    <h5 class="mb-2">PayPal Sandbox</h5>
    <p class="mb-2">Open the sandbox dashboard to view balances and activity (login with your sandbox buyer or business account):</p>
    <a class="btn btn-outline-primary" href="<%= sandboxDashboard %>" target="_blank" rel="noreferrer">Open PayPal Sandbox Dashboard</a>
  </div>

  <div class="card p-3">
    <h5 class="mb-3">Recent PayPal Transactions (site records)</h5>
    <% if (transactions && transactions.length) { %>
      <div class="list-group">
        <% transactions.forEach(function(tx){ %>
          <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <div><strong><%= tx.orderNumber %></strong> • <small class="text-muted"><%= tx.paymentMethod %></small></div>
              <div class="text-muted small">Placed: <%= tx.createdAt %></div>
            </div>
            <div class="text-end">
              <div><strong>S$ <%= Number(tx.total||0).toFixed(2) %></strong></div>
              <div class="small text-success"><%= tx.paid ? 'Paid' : 'Pending' %></div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-muted">No PayPal transactions recorded yet.</p>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
